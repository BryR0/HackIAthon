# Proveedor de clasificacion de sintomas.
# Valores: gemini | groq | openai | anthropic | ollama | local
# Si se omite, se autodetecta el primer proveedor con credencial presente.
# Si ninguno tiene credencial, degrada a "local" (determinista) y la interfaz
# lo rotula visiblemente. Ver docs/adr/0001-mvp-stack-and-rules.md D2.
AI_PROVIDER=local

# Credencial del proveedor. NUNCA se expone al navegador: solo servidor.
# Dejar vacio para operar en modo local determinista.
AI_API_KEY=

# Modelo del proveedor. Vacio usa el default del adaptador, que para Gemini es
# el alias gemini-flash-latest: un pin concreto puede retirarse sin aviso.
AI_MODEL=

# Solo para desarrollo con Ollama. Vercel no puede alcanzar localhost.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2

# Banderas de rollback (Blueprint secciones 8 y 9).
# ESTIMATE_ENGINE: v1 | mock
# UI_DATA_SOURCE:  api | fixtures
ESTIMATE_ENGINE=v1
UI_DATA_SOURCE=api
