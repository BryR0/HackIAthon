    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "22.18.1",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "eslint": "9.35.0",
    "eslint-config-next": "^15.5.25",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9.2",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "postcss": "8.5.28"
